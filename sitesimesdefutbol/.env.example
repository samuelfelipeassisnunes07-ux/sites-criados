# =====================================================================
#  Simês de Fútbol - Configuração de ambiente
#  Copie este arquivo para ".env" e preencha os valores.
#  NUNCA versione o arquivo .env real.
# =====================================================================

# --- Aplicação -------------------------------------------------------
APP_NAME="Simês de Fútbol"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
# Gere com: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Banco de dados --------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sitesimesdefutbol
DB_USERNAME=root
DB_PASSWORD=

# --- Sessão ----------------------------------------------------------
SESSION_NAME=sime_store_session

# --- E-mail ----------------------------------------------------------
# driver=log  -> grava os e-mails em storage/logs/mail.log (desenvolvimento)
# driver=mail -> usa a função mail() do PHP (precisa de servidor SMTP configurado)
MAIL_DRIVER=log
MAIL_FROM=no-reply@simesdefutbol.local
MAIL_FROM_NAME="Simês de Fútbol"
# Usado no link de recuperação de senha. Se vazio, usa APP_URL.
APP_PUBLIC_URL=

# --- Pagamento -------------------------------------------------------
# demo        -> modo demonstração (pagamento SIMULADO, identificado na tela)
# mercadopago -> integração real via Checkout Pro (requer credenciais)
PAYMENT_GATEWAY=demo
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Segredo para validar a assinatura x-signature do webhook do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true

# --- Frete (modo simples, sem integração externa) --------------------
SHIPPING_FLAT_RATE=24.90
FREE_SHIPPING_THRESHOLD=299.00
PICKUP_ENABLED=true
PICKUP_ADDRESS="Rua das Peladas, 10 - Centro, São Paulo/SP"

# --- Uploads ---------------------------------------------------------
UPLOAD_MAX_MB=3
